    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@fastify/jwt": "10.0.0",
    "@prisma/client": "6.15.0",
    "@prisma/extension-accelerate": "2.0.2",
